set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(STAR_TOOLING "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
file(GLOB STAR_LLVM_ROOT "${STAR_TOOLING}/llvm-mingw-*")
list(GET STAR_LLVM_ROOT 0 STAR_LLVM_ROOT)
set(CMAKE_C_COMPILER "${STAR_LLVM_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${STAR_LLVM_ROOT}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${STAR_LLVM_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${STAR_LLVM_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${STAR_LLVM_ROOT}/bin/llvm-ranlib")
